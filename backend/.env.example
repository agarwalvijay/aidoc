# App
APP_NAME=AI Doctor
APP_ENV=dev
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Safety policy
CONSERVATIVE_MODE=true
# When true, LLM may recommend specific drugs (OTC + limited Rx: amoxicillin,
# nitrofurantoin, sumatriptan, ondansetron, etc.). Controlled substances are
# always excluded. Default false = "ask your clinician about X" framing only.
PRESCRIBING_ENABLED=false
MIN_TURNS_BEFORE_ASSESSMENT=3
# 12 gives mental health (PHQ-9 + suicidality) enough room;
# simpler presentations (URI, UTI, GI) self-terminate well before this.
MAX_TURNS_BEFORE_ASSESSMENT=12

# TTS — set false to force Web Speech API (browser built-in) instead of OpenAI neural TTS
TTS_ENABLED=true

# LLM provider — choose one: anthropic | openai | deepseek | groq | google
LLM_ENABLED=true
LLM_PROVIDER=anthropic

# Anthropic Claude (recommended — best clinical reasoning)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Groq (OpenAI-compatible, fast)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro
